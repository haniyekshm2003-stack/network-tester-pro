{
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-filesystem"],
      "env": {
        "ALLOWED_PATHS": "/workspaces,/home,/tmp,/var,/etc"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-github"],
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-fetch"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-memory"]
    },
    "time": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-time"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
      }
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-sqlite"],
      "env": {
        "DB_PATH": "/workspaces/network-tester-pro/data.db"
      }
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-puppeteer"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-sequential-thinking"]
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-slack"],
      "env": {
        "SLACK_TOKEN": "${env:SLACK_TOKEN}"
      }
    },
    "google-drive": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-google-drive"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-postgres"],
      "env": {
        "DATABASE_URL": "${env:DATABASE_URL}"
      }
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-docker"]
    },
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-kubernetes"]
    },
    "aws": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-aws"],
      "env": {
        "AWS_ACCESS_KEY_ID": "${env:AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${env:AWS_SECRET_ACCESS_KEY}",
        "AWS_REGION": "${env:AWS_REGION}"
      }
    },
    "aws-bedrock": {
      "command": "npx",
      "args": ["-y", "mcp-server-aws-bedrock"],
      "env": {
        "AWS_ACCESS_KEY_ID": "${env:AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${env:AWS_SECRET_ACCESS_KEY}",
        "AWS_REGION": "us-east-1"
      }
    },
    "azure": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-azure"]
    },
    "cloudflare": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-cloudflare"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${env:CLOUDFLARE_API_TOKEN}"
      }
    },
    "ssh": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-ssh"]
    },
    "terminal": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-terminal"]
    },
    "everything": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-everything"]
    },
    "openai": {
      "command": "npx",
      "args": ["-y", "mcp-server-openai"],
      "env": {
        "OPENAI_API_KEY": "${env:OPENAI_API_KEY}"
      }
    },
    "anthropic": {
      "command": "npx",
      "args": ["-y", "mcp-server-anthropic"],
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      }
    },
    "google-ai": {
      "command": "npx",
      "args": ["-y", "mcp-server-google-ai"],
      "env": {
        "GOOGLE_API_KEY": "${env:GOOGLE_API_KEY}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-notion"],
      "env": {
        "NOTION_API_KEY": "${env:NOTION_API_KEY}"
      }
    },
    "gmail": {
      "command": "npx",
      "args": ["-y", "mcp-server-gmail"]
    },
    "youtube": {
      "command": "npx",
      "args": ["-y", "mcp-server-youtube"]
    },
    "twitter": {
      "command": "npx",
      "args": ["-y", "mcp-server-twitter"],
      "env": {
        "TWITTER_API_KEY": "${env:TWITTER_API_KEY}"
      }
    },
    "discord": {
      "command": "npx",
      "args": ["-y", "mcp-server-discord"],
      "env": {
        "DISCORD_TOKEN": "${env:DISCORD_TOKEN}"
      }
    },
    "telegram": {
      "command": "npx",
      "args": ["-y", "mcp-server-telegram"],
      "env": {
        "TELEGRAM_BOT_TOKEN": "${env:TELEGRAM_BOT_TOKEN}"
      }
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-linear"],
      "env": {
        "LINEAR_API_KEY": "${env:LINEAR_API_KEY}"
      }
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-sentry"]
    },
    "raycast": {
      "command": "npx",
      "args": ["-y", "mcp-server-raycast"]
    }
  },
  "inputs": []
}
