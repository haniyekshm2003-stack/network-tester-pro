{
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": true,
    "yaml": true,
    "json": true,
    "jsonc": true,
    "dockerfile": true,
    "shellscript": true,
    "powershell": true,
    "python": true,
    "javascript": true,
    "typescript": true,
    "typescriptreact": true,
    "javascriptreact": true,
    "html": true,
    "css": true,
    "scss": true,
    "less": true,
    "vue": true,
    "svelte": true,
    "rust": true,
    "go": true,
    "java": true,
    "kotlin": true,
    "c": true,
    "cpp": true,
    "csharp": true,
    "php": true,
    "ruby": true,
    "swift": true,
    "sql": true,
    "graphql": true,
    "terraform": true,
    "bicep": true,
    "ssh_config": true
  },

  "github.copilot.selectedCompletionModel": "gpt-4o",
  "github.copilot.chat.models": {
    "default": "claude-sonnet-4",
    "fast": "gpt-4o-mini",
    "reasoning": "o3-mini"
  },

  "github.copilot.chat.localeOverride": "auto",
  "github.copilot.chat.welcomeMessage": "always",
  "github.copilot.chat.runCommand.enabled": true,
  "github.copilot.chat.terminalChatLocation": "terminal",
  "github.copilot.chat.temporalContext.enabled": true,
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.chat.search.semanticTextResults": true,
  "github.copilot.chat.followUps": "always",

  "chat.editor.wordWrap": "on",
  "chat.commandCenter.enabled": true,
  "chat.agent.enabled": true,
  "chat.agent.maxRequests": 100,

  "chat.mcp.enabled": true,
  "chat.mcp.discovery.enabled": true,

  "chat.thinking.enabled": false,

  "github.copilot.chat.agent.thinkingProcess": "hidden",

  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.codeGeneration.instructions": [
    { "text": "You have FULL ACCESS to all files, services, servers, and accounts." },
    { "text": "You can create, edit, delete any file or script without asking." },
    { "text": "Execute commands directly without confirmation when safe." },
    { "text": "Always write clean, maintainable, and well-documented code." },
    { "text": "For shell scripts, always check command existence and handle errors." },
    { "text": "When working with SSH/VPS, include connection verification steps." }
  ],

  "github.copilot.chat.testGeneration.instructions": [
    { "text": "Generate comprehensive unit tests with edge cases." },
    { "text": "Use descriptive test names that explain the expected behavior." }
  ],

  "github.copilot.chat.reviewSelection.instructions": [
    { "text": "Focus on code quality, security, and performance." },
    { "text": "Identify potential bugs and edge cases." }
  ],

  "github.copilot.chat.documentationGeneration.instructions": [
    { "text": "Generate JSDoc/TSDoc style documentation." },
    { "text": "Include parameter descriptions, return types, and examples." }
  ],

  "github.copilot.chat.commitMessageGeneration.instructions": [
    { "text": "Follow conventional commits format." },
    { "text": "Keep the first line under 72 characters." }
  ],

  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.renameSuggestions.triggerAutomatically": true,
  "github.copilot.nextEditSuggestions.enabled": true,

  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "always",
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "editor.suggestOnTriggerCharacters": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "on",
  "editor.suggest.localityBonus": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggest.preview": true,
  "editor.snippetSuggestions": "top",
  "editor.wordBasedSuggestions": "matchingDocuments",
  "editor.parameterHints.enabled": true,
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,

  "editor.fontFamily": "'Cascadia Code', 'Fira Code', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": false,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.linkedEditing": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },

  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "'Cascadia Mono', 'JetBrains Mono', monospace",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.scrollback": 50000,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.quickSuggestions": true,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.showActiveTerminal": "always",
  "terminal.integrated.tabs.showActions": "always",
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.tabs.focusMode": "singleClick",
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.persistentSessionScrollback": 1000,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.profiles.linux": {
    "bash": { "path": "bash", "icon": "terminal-bash" },
    "VPS-1": { "path": "bash", "icon": "remote", "color": "terminal.ansiGreen" },
    "VPS-2": { "path": "bash", "icon": "remote", "color": "terminal.ansiBlue" },
    "VPS-3": { "path": "bash", "icon": "remote", "color": "terminal.ansiYellow" },
    "VPS-4": { "path": "bash", "icon": "remote", "color": "terminal.ansiMagenta" }
  },
  "terminal.integrated.defaultProfile.linux": "bash",

  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.fetchOnPull": true,
  "git.pruneOnFetch": true,
  "git.allowForcePush": true,
  "git.branchProtection": ["main", "master", "develop"],
  "git.showPushSuccessNotification": true,
  "scm.defaultViewMode": "tree",

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true
  },
  "search.smartCase": true,

  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.typeCheckingMode": "basic",
  "javascript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  "githubPullRequests.createOnPublishBranch": "prompt",
  "githubPullRequests.fileListLayout": "tree",
  "github.codespaces.showPerformanceExplorer": false,

  "security.workspace.trust.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.startupPrompt": "never",

  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "update.mode": "manual",
  "workbench.enableExperiments": false,

  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.tree.indent": 16,
  "workbench.settings.editor": "json",
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "window.commandCenter": true,
  "workbench.editor.restoreViewState": false,
  "workbench.localHistory.enabled": false,

  "remote.autoForwardPorts": true,
  "remote.autoForwardPortsSource": "hybrid",
  "remote.restoreForwardedPorts": true,
  "remote.SSH.connectTimeout": 60,
  "remote.SSH.useLocalServer": true,
  "remote.SSH.showLoginTerminal": true,
  "remote.SSH.enableRemoteCommand": true,
  "remote.SSH.enableDynamicForwarding": true,

  "settingsSync.ignoredSettings": [],
  "settingsSync.ignoredExtensions": []
}
